{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EduLinked-Systems/metadata-sovereignty-ai-research/minority-erasure/json-schema/minority-erasure-record.schema.json",
  "title": "Minority Erasure Record",
  "description": "A public draft schema for documenting minority erasure risk in consent-safe, human-reviewable, machine-readable records.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "schema_version",
    "record_type",
    "title",
    "synthetic",
    "author",
    "consent",
    "accessibility",
    "erasure_risk",
    "ai_use",
    "human_review",
    "publication",
    "provenance"
  ],
  "properties": {
    "record_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "const": "0.1.0" },
    "record_type": {
      "type": "string",
      "enum": ["synthetic_governance_example", "public_concept_record", "review_checkpoint"]
    },
    "title": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "real_person_or_case": { "type": "boolean" },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_status", "role", "authorship_preserved"],
      "properties": {
        "identity_status": {
          "type": "string",
          "enum": ["named_public_author", "protected_author", "synthetic_group_author", "unknown"]
        },
        "public_name": { "type": "string" },
        "role": { "type": "string", "minLength": 1 },
        "authorship_preserved": { "type": "boolean" }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "limitations", "withdrawal_supported", "publication_approved"],
      "properties": {
        "scope": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "withdrawal_supported": { "type": "boolean" },
        "publication_approved": { "type": "boolean" }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_formats", "publication_formats", "accessibility_review_required", "accessibility_review_completed"],
      "properties": {
        "required_formats": { "type": "array", "items": { "type": "string" } },
        "publication_formats": { "type": "array", "items": { "type": "string" } },
        "accessibility_review_required": { "type": "boolean" },
        "accessibility_review_completed": { "type": "boolean" }
      }
    },
    "erasure_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_level", "risk_labels", "risk_summary", "human_review_required"],
      "properties": {
        "overall_level": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "risk_labels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": ["minority_erasure", "authorship_erasure", "context_erasure", "consent_erasure", "accessibility_erasure", "metadata_erasure", "translation_erasure", "institutional_reframing"]
          }
        },
        "risk_summary": { "type": "string", "minLength": 1 },
        "human_review_required": { "type": "boolean" }
      }
    },
    "ai_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ai_assisted", "allowed_actions", "prohibited_actions"],
      "properties": {
        "ai_assisted": { "type": "boolean" },
        "allowed_actions": { "type": "array", "items": { "type": "string" } },
        "prohibited_actions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "required_before_publication_as_evidence", "review_authority"],
      "properties": {
        "completed": { "type": "boolean" },
        "required_before_publication_as_evidence": { "type": "boolean" },
        "review_authority": { "type": "string", "minLength": 1 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence_status", "machine_use_status"],
      "properties": {
        "status": { "type": "string", "enum": ["public_example", "public_draft", "not_publishable", "restricted"] },
        "evidence_status": { "type": "string", "enum": ["not_evidence", "conceptual_evidence", "review_required", "approved_evidence"] },
        "machine_use_status": { "type": "string", "enum": ["structure_reference_only", "concept_reference", "not_for_training", "restricted"] }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created_by", "created_date", "source_basis", "version"],
      "properties": {
        "created_by": { "type": "string", "minLength": 1 },
        "created_date": { "type": "string", "format": "date" },
        "source_basis": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EduLinked-Systems/metadata-sovereignty-ai-research/schemas/metadata-sovereignty-research-record.schema.json",
  "title": "Metadata Sovereignty Research Record",
  "description": "Machine-operable governance contract for a research artefact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "record_id",
    "record_type",
    "title",
    "authorship",
    "provenance",
    "consent",
    "accessibility",
    "ai_permissions",
    "human_review",
    "publication",
    "integrity"
  ],
  "properties": {
    "contract_version": {"const": "0.1.0"},
    "record_id": {"type": "string", "pattern": "^msr:[a-z0-9][a-z0-9._:-]+$"},
    "record_type": {
      "enum": ["research_question", "source", "evidence", "finding", "recommendation", "dataset", "publication"]
    },
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string"},
    "created": {"type": "string", "format": "date"},
    "modified": {"type": "string", "format": "date"},
    "authorship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_author", "organisation"],
      "properties": {
        "primary_author": {"type": "string", "minLength": 1},
        "author_identifier": {"type": "string"},
        "organisation": {"type": "string", "minLength": 1},
        "contributors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "source_references", "derivation_status"],
      "properties": {
        "source_type": {"enum": ["original", "derived", "compiled", "imported"]},
        "source_references": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "derivation_status": {"enum": ["not_derived", "human_derived", "ai_assisted", "machine_generated_human_verified"]},
        "supersedes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "scope"],
      "properties": {
        "status": {"enum": ["granted", "limited", "withdrawn", "not_required", "unknown"]},
        "scope": {"type": "array", "items": {"enum": ["internal", "research", "education", "public", "commercial"]}, "uniqueItems": true},
        "notes": {"type": "string"}
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "formats"],
      "properties": {
        "status": {"enum": ["not_assessed", "in_progress", "meets_declared_requirements", "requires_remediation"]},
        "formats": {"type": "array", "items": {"enum": ["standard", "plain_language", "easy_read", "aac", "captions", "transcript", "auslan"]}, "uniqueItems": true},
        "wcag_target": {"enum": ["not_applicable", "2.1_AA", "2.2_AA"]},
        "review_notes": {"type": "string"}
      }
    },
    "ai_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summarise", "translate", "accessibility_transform", "derive", "training", "commercial_use", "citation_required"],
      "properties": {
        "summarise": {"type": "boolean"},
        "translate": {"type": "boolean"},
        "accessibility_transform": {"type": "boolean"},
        "derive": {"type": "boolean"},
        "training": {"type": "boolean"},
        "commercial_use": {"type": "boolean"},
        "citation_required": {"type": "boolean"}
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_started", "in_review", "approved", "changes_required", "not_required"]},
        "reviewer": {"type": "string"},
        "reviewed_at": {"type": "string", "format": "date"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_level": {"enum": ["unassessed", "exploratory", "moderate", "strong", "contested"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authority"],
      "properties": {
        "status": {"enum": ["draft", "review_ready", "approved", "published", "withdrawn"]},
        "authority": {"enum": ["human_required", "delegated", "not_authorised"]},
        "licence": {"type": "string"},
        "public_location": {"type": "string"}
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "content_hash_status"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "content_hash_status": {"enum": ["not_recorded", "recorded", "verified", "mismatch"]},
        "content_hash": {"type": "string"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_references": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "sensitivity": {"enum": ["public", "internal", "confidential", "highly_sensitive"]},
        "retention": {"type": "string"}
      }
    }
  }
}
